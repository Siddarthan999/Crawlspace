# Copy to .env and adjust. Everything here is optional — docker-compose.yml has sensible defaults.

# How many crawls can run at the same time
MAX_PARALLEL_CRAWLS=2

# Which interface the dashboard and API listen on. 127.0.0.1 = this machine only (recommended —
# Crawlspace has no login). Set to 0.0.0.0 only behind something that adds authentication.
BIND_ADDRESS=127.0.0.1

# Port the dashboard is served on (host side)
FRONTEND_PORT=8080

# Port the API is exposed on (host side) — used for /docs and direct API calls
BACKEND_PORT=8000

# Database password. Changing it after the first run requires `docker compose down -v` (it wipes data).
POSTGRES_PASSWORD=seo

# ---- Lighthouse (PageSpeed Insights) -------------------------------------------------
# Works without a key, but the free anonymous quota is shared and runs out fast.
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# ---- Google Search Console (OAuth) ---------------------------------------------------
# See docs/ADVANCED.md "Integrations setup". The redirect URI must match one registered on your OAuth client.
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REDIRECT_URI=http://localhost:8080/api/gsc/callback

# ---- Backlink sources (free) ---------------------------------------------------------
# Bing Webmaster Tools -> Settings -> API access. Only returns data for sites you've verified there.
BING_WEBMASTER_API_KEY=
# https://www.domcop.com/openpagerank/ — domain authority score for any domain.
OPENPAGERANK_API_KEY=
